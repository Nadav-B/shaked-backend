scalar Date
scalar Long

type Service {
    id:Long!
    title:String
    introduction:String
    content:String
    contactButton:String
}

type Article {
    id:Long!
    title:String
    tag:String
    introduction:String
    content:String
    contactButton:String
    #    modificationDate: Date
}

type Contact {
    id:ID!
    fullName:String
    phoneNumber: String
    email: String
    address: String
    category: String
    date: Date
    survey: Survey
    comment:String
}

type Survey {
    id:ID
    name:String
    answers:[Answer]
}

type Answer {
    id:ID
    question: String
    answer: String
}

type TextContainer {
    id:ID!
    tag:String
    content:String
}

type Query {
    service(id: ID!):Service
    services:[Service]
    article(id: ID!):Article
    articles:[Article]
    text(id:ID!): TextContainer
    texts: [TextContainer]
    contacts:[Contact]
}

input ContactInput {
    fullName:String
    phoneNumber: String
    email: String
    address: String
    category: String
    survey: SurveyInput
}

input SurveyInput{
    name:String
    answers:[AnswerInput]
}

input AnswerInput {
    question: String
    answer: String
}

type Mutation {
    createContact(contactInput:ContactInput!):Contact
    deleteContact(id:ID!):ID!
}